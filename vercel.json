{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx --yes pnpm@9.15.9 --dir web install --no-frozen-lockfile",
  "buildCommand": "npx --yes pnpm@9.15.9 --dir web --filter @bitchord/app build",
  "outputDirectory": "web/app/dist",
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|assets/|icons/|models/|downloads/|apple-touch-icon\\.png|favicon\\.svg|manifest\\.webmanifest).*)",
      "destination": "/index.html"
    }
  ]
}
